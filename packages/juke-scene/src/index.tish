import {
  clampRows as clampRowsImpl,
  computeCols as computeColsImpl,
  computeLayout as computeLayoutImpl,
  trackToCardSong as trackToCardSongImpl,
  makeSceneFromTracks as makeSceneFromTracksImpl,
} from "./scene.tish"

import {
  slotPosition as slotPositionImpl,
  makeSceneFromArt as makeSceneFromArtImpl,
  CARD_W as CARD_W_VAL,
  CARD_GAP as CARD_GAP_VAL,
  ROW_SPACING as ROW_SPACING_VAL,
  CARD_RADIAL_OFFSET as CARD_RADIAL_OFFSET_VAL,
} from "./layout.tish"

import { generateDebugTracks as generateDebugTracksImpl } from "./debug.tish"

import {
  DEFAULT_ROWS as DEFAULT_ROWS_VAL,
  SPIN_MAX as SPIN_MAX_VAL,
  SPIN_STEP as SPIN_STEP_VAL,
  clampSpin as clampSpinImpl,
  clampUnit as clampUnitImpl,
  defaultMode as defaultModeImpl,
} from "./mode.tish"

import {
  createSceneBuilder as createSceneBuilderImpl,
  stepSceneBuilder as stepSceneBuilderImpl,
  sceneFromBuilder as sceneFromBuilderImpl,
  builderProgress as builderProgressImpl,
} from "./prepare.tish"

export fn clampRows(n) {
  return clampRowsImpl(n)
}

export fn computeCols(trackCount, rows) {
  return computeColsImpl(trackCount, rows)
}

export fn computeLayout(tracks, rows, seed) {
  return computeLayoutImpl(tracks, rows, seed)
}

export fn trackToCardSong(t, c, r) {
  return trackToCardSongImpl(t, c, r)
}

export fn makeSceneFromTracks(tracks, rows, seed) {
  return makeSceneFromTracksImpl(tracks, rows, seed)
}

export fn slotPosition(c, r, cols, rows) {
  return slotPositionImpl(c, r, cols, rows)
}

export fn makeSceneFromArt(art, cols, rows) {
  return makeSceneFromArtImpl(art, cols, rows)
}

export fn generateDebugTracks(count) {
  return generateDebugTracksImpl(count)
}

export fn clampSpin(n) {
  return clampSpinImpl(n)
}

export fn clampUnit(n) {
  return clampUnitImpl(n)
}

export fn defaultMode(opts) {
  return defaultModeImpl(opts)
}

export fn createSceneBuilder(tracks, rows, seed) {
  return createSceneBuilderImpl(tracks, rows, seed)
}

export fn stepSceneBuilder(builder, batchSize) {
  return stepSceneBuilderImpl(builder, batchSize)
}

export fn sceneFromBuilder(builder) {
  return sceneFromBuilderImpl(builder)
}

export fn builderProgress(builder) {
  return builderProgressImpl(builder)
}

export const CARD_W = CARD_W_VAL
export const CARD_GAP = CARD_GAP_VAL
export const ROW_SPACING = ROW_SPACING_VAL
export const CARD_RADIAL_OFFSET = CARD_RADIAL_OFFSET_VAL
export const DEFAULT_ROWS = DEFAULT_ROWS_VAL
export const SPIN_MAX = SPIN_MAX_VAL
export const SPIN_STEP = SPIN_STEP_VAL
