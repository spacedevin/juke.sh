// Native jukebox iOS — full scene port (Tish-first).

import { ios, useState, useEffect, useRef } from "tish:ios"
import { setTimeout, clearTimeout, setInterval, clearInterval } from "tish:timers"
import {
  version as sceneVersion,
  getActiveIndex,
  getActiveTitle,
  getQueuedCount,
  getLighting,
  resetSceneCamera,
  debugSceneParse,
} from "tish:juke-scene"
import {
  generateDebugTracks,
  DEFAULT_ROWS,
  createSceneBuilder,
  stepSceneBuilder,
  sceneFromBuilder,
  builderProgress,
  defaultMode,
  clampRows,
} from "@spacedevin/juke-scene"
import { preloadCardFonts } from "@spacedevin/juke-cards"
import { SettingsPanel } from "./components/SettingsPanel.tish"

const SCENE_SEED = 42
const PREPARE_BATCH = 6
const DEBUG_TRACKS = 120
const POLL_MS = 1000
const PLAYBACK_TOAST_MS = 6000
const SCENE_HEIGHT = 760

async fn loadCardFonts(setFontsReady) {
  try { await preloadCardFonts() } catch (e) { }
  setFontsReady(true)
}

fn pollSceneState(scene, hasActive, lastStatus, setHasActive, setStatusLine, modeRef) {
  let activeIdx = getActiveIndex()
  let nextHasActive = activeIdx >= 0
  modeRef.current.lighting = getLighting()
  let parseText = scene !== null ? debugSceneParse(scene) : "no scene"
  let line = (
    "Active: " + (activeIdx >= 0 ? activeIdx : "—")
    + " · Queued: " + getQueuedCount()
    + " · Light: " + getLighting().toFixed(2)
    + " · " + parseText
  )
  if (line !== lastStatus.current) {
    lastStatus.current = line
    setStatusLine(line)
  }
  if (nextHasActive !== hasActive) {
    setHasActive(nextHasActive)
  }
}

fn App() {
  let [scene, setScene] = useState(null)
  let [builder, setBuilder] = useState(null)
  let [rows, setRows] = useState(DEFAULT_ROWS)
  let [showSettings, setShowSettings] = useState(false)
  let [settingsTick, setSettingsTick] = useState(0)
  let [hasActive, setHasActive] = useState(false)
  let [statusLine, setStatusLine] = useState("Loading…")
  let [playbackMsg, setPlaybackMsg] = useState("")
  let [fontsReady, setFontsReady] = useState(false)

  let modeRef = useRef(defaultMode({ spin: 0.35, lighting: 0.5 }))
  let lastStatus = useRef("")
  let playbackTimer = useRef(null)
  let prepareKey = builder === null ? -1 : builder.slotIndex

  useEffect(() => {
    loadCardFonts(setFontsReady)
  }, [])

  useEffect(() => {
    if (!fontsReady) { return }
    setScene(null)
    resetSceneCamera()
    setBuilder(createSceneBuilder(generateDebugTracks(DEBUG_TRACKS), rows, SCENE_SEED))
  }, [fontsReady, rows])

  useEffect(() => {
    if (builder === null) {
      return
    }
    let b = builder
    let timer = setTimeout(() => {
      if (b.slotIndex >= b.layout.slots.length) {
        setScene(sceneFromBuilder(b))
        setBuilder(null)
        resetSceneCamera()
        return
      }
      setBuilder(stepSceneBuilder(b, PREPARE_BATCH))
    }, 0)
    return () => clearTimeout(timer)
  }, [prepareKey, rows])

  useEffect(() => {
    let timer = setInterval(() => {
      pollSceneState(scene, hasActive, lastStatus, setHasActive, setStatusLine, modeRef)
    }, POLL_MS)
    return () => clearInterval(timer)
  }, [scene, hasActive])

  useEffect(() => {
    return () => {
      if (playbackTimer.current !== null) { clearTimeout(playbackTimer.current) }
    }
  }, [])

  fn bumpSettings() {
    setSettingsTick(settingsTick + 1)
  }

  fn showPlaybackToast(msg) {
    setPlaybackMsg(msg)
    if (playbackTimer.current !== null) { clearTimeout(playbackTimer.current) }
    playbackTimer.current = setTimeout(() => {
      setPlaybackMsg("")
      playbackTimer.current = null
    }, PLAYBACK_TOAST_MS)
  }

  fn onCloseSettings() {
    setShowSettings(false)
    bumpSettings()
  }

  fn onChangeRows(n) {
    setRows(clampRows(n))
    bumpSettings()
  }

  fn onOpenSettings() {
    setShowSettings(true)
    bumpSettings()
  }

  fn onSelect(slot) {
    let title = getActiveTitle()
    if (title === "") { title = "slot " + slot }
    showPlaybackToast("Would play: " + title)
  }

  fn onQueue(slot) {
    showPlaybackToast("Queued slot " + slot)
  }

  let m = modeRef.current
  let prepareProgress = builder !== null ? builderProgress(builder) : null

  return (
    <div paddingTop={44} paddingLeft={4} paddingRight={4} paddingBottom={4}>
      {showSettings ? null
        : <p>{"juke.sh · " + sceneVersion}</p>}
      {showSettings ? null : <p>{statusLine}</p>}
      {!hasActive && scene !== null && !showSettings
        ? <p>{"TAP TO PLAY · HOLD TO QUEUE"}</p>
        : null}
      {!hasActive && scene !== null && !showSettings
        ? <p>{"SPIN LEFT/RIGHT · LIGHTING UP/DOWN · PINCH TO ZOOM · DOUBLE-TAP FOR SETTINGS"}</p>
        : null}
      {playbackMsg !== ""
        ? <p>{playbackMsg}</p>
        : null}
      {prepareProgress !== null
        ? <p>{"Preparing " + prepareProgress.cards + " cards…"}</p>
        : null}
      <SceneView
        height={SCENE_HEIGHT}
        scene={scene}
        rows={rows}
        spin={m.spin}
        lighting={m.lighting}
        zoomTight={m.zoomTight}
        zoomFlat={m.zoomFlat}
        showCategories={m.showCategories}
        audioEnabled={m.audioEnabled}
        settingsTick={settingsTick}
        onSelect={onSelect}
        onQueue={onQueue}
        onOpenSettings={onOpenSettings}
      />
      <SettingsPanel
        open={showSettings}
        modeRef={modeRef}
        rows={rows}
        onChangeRows={onChangeRows}
        onClose={onCloseSettings}
        onPanelChange={bumpSettings}
      />
    </div>
  )
}

ios.run(App)
