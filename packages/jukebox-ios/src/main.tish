// Native jukebox iOS — card art + Metal drum scene.
//
// Build: `just run-jukebox-ios-sim` from jukebox repo root.

import { ios, useState, useEffect, useMemo } from "tish:ios"
import { setTimeout, clearTimeout } from "tish:timers"
import { isLoggedIn } from "tish:spotify-ios"
import { version as sceneVersion } from "tish:juke-scene"
import {
  generateDebugTracks,
  DEFAULT_ROWS,
  SPIN_MAX,
  SPIN_STEP,
  createSceneBuilder,
  stepSceneBuilder,
  sceneFromBuilder,
  builderProgress,
} from "@spacedevin/juke-scene"

const SCENE_SEED = 42
const PREPARE_BATCH = 6
const DEBUG_TRACKS = 60
let debugTracks = generateDebugTracks(DEBUG_TRACKS)

fn App() {
  let [scene, setScene] = useState(null)
  let [builder, setBuilder] = useState(null)
  let [spin, setSpin] = useState(0.35)
  let [activeIdx, setActiveIdx] = useState(-1)
  let [queued, setQueued] = useState({})
  let loggedIn = isLoggedIn()

  let prepareKey = builder === null ? -1 : builder.slotIndex

  useEffect(() => {
    if (builder === null) {
      return
    }
    let b = builder
    let timer = setTimeout(() => {
      if (b.slotIndex >= b.layout.slots.length) {
        setScene(sceneFromBuilder(b))
        setBuilder(null)
        return
      }
      setBuilder(stepSceneBuilder(b, PREPARE_BATCH))
    }, 0)
    return () => clearTimeout(timer)
  }, [prepareKey])

  fn loadScene() {
    if (builder !== null) {
      return
    }
    setScene(null)
    setActiveIdx(-1)
    setQueued({})
    setTimeout(() => {
      setBuilder(createSceneBuilder(debugTracks, DEFAULT_ROWS, SCENE_SEED))
    }, 0)
  }

  fn spinDown() {
    let n = spin - SPIN_STEP
    if (n < -SPIN_MAX) { n = -SPIN_MAX }
    setSpin(n)
  }

  fn spinUp() {
    let n = spin + SPIN_STEP
    if (n > SPIN_MAX) { n = SPIN_MAX }
    setSpin(n)
  }

  fn spinOff() {
    setSpin(0)
  }

  fn queuedIndices() {
    let out = []
    let keys = Object.keys(queued)
    let i = 0
    while (i < keys.length) {
      if (queued[keys[i]]) { out.push(parseInt(keys[i])) }
      i = i + 1
    }
    return out
  }

  let activeLabel = "—"
  if (activeIdx >= 0 && scene !== null && scene.cells !== null) {
    let cell = scene.cells[activeIdx]
    if (cell !== null && cell.titleA) {
      activeLabel = cell.titleA
    } else {
      activeLabel = "#" + activeIdx
    }
  }

  let prepareProgress = builder !== null ? builderProgress(builder) : null
  let sceneLabel = prepareProgress !== null
    ? ("prep " + prepareProgress.cards + "/" + prepareProgress.tracks)
    : (scene === null
      ? "no scene"
      : (scene.cols + "x" + scene.rows + " · " + scene.cells.length + " cards"))
  let loadLabel = builder !== null ? "Preparing…" : (scene === null ? "Load scene" : "Reload")

  let statusLine = "juke.sh · " + sceneVersion + " · " + sceneLabel
    + " · Active: " + activeLabel
    + " · Queued: " + queuedIndices().length
    + " · Spin: " + spin
    + " · Spotify: " + (loggedIn ? "in" : "out")

  return (
    <div>
      <p>{statusLine}</p>
      <SceneView
        height={420}
        scene={scene}
        spin={spin}
        queued={queuedIndices()}
        onCardSelect={(idx) => {
          setActiveIdx(idx)
          let next = {}
          let keys = Object.keys(queued)
          let i = 0
          while (i < keys.length) {
            let k = parseInt(keys[i])
            if (k !== idx && queued[k]) { next[k] = true }
            i = i + 1
          }
          setQueued(next)
        }}
        onCardQueue={(idx) => {
          let on = queued[idx] !== true
          let next = {}
          let keys = Object.keys(queued)
          let i = 0
          while (i < keys.length) {
            let k = parseInt(keys[i])
            if (k !== idx && queued[k]) { next[k] = true }
            i = i + 1
          }
          if (on) { next[idx] = true }
          setQueued(next)
        }}
      />
      <row>
        <button onClick={() => loadScene()}>{loadLabel}</button>
        <button onClick={() => spinOff()}>Spin off</button>
        <button onClick={() => spinDown()}>Spin −</button>
        <button onClick={() => spinUp()}>Spin +</button>
      </row>
    </div>
  )
}

ios.run(App)
