// View preferences persisted to localStorage (via public/prefs-bridge.js).
//   - spin, rows, lighting, showCategories, zoomTight, zoomFlat, audioEnabled, shuffle

fn bridge() {
  if (typeof window === "undefined") { return null }
  return window.__jukePrefs
}

export fn loadPrefs() {
  let b = bridge()
  if (b === null) { return {} }
  return b.load()
}

export fn savePrefs(patch) {
  let b = bridge()
  if (b === null) { return }
  b.save(patch)
}

export fn flushPrefs() {
}

export fn prefNumber(prefs, key, fallback) {
  if (prefs === null || typeof prefs !== "object") { return fallback }
  if (!(key in prefs)) { return fallback }
  let v = prefs[key]
  if (typeof v === "number" && v === v) { return v }
  if (typeof v === "string" && v !== "") {
    let n = Number(v)
    if (typeof n === "number" && n === n) { return n }
  }
  return fallback
}
